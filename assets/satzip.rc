// Windows resource script: embeds the app icon (and version info) into the
// satzip executables.  The numerically-lowest ICON id is what Explorer, the
// taskbar and GLFW's default window icon pick up, so keep IDI_ICON1 first.
#include <windows.h>
#include "satzip_version.h"     // generated by CMake from project(VERSION)

IDI_ICON1 ICON "icon.ico"

#ifndef SATZIP_VER_STR
#define SATZIP_VER_STR "0.0.0.0"
#endif
#ifndef SATZIP_VER_RC
#define SATZIP_VER_RC  0,0,0,0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    SATZIP_VER_RC
 PRODUCTVERSION SATZIP_VER_RC
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Samalth"
            VALUE "FileDescription",  "SAT-ZIP"
            VALUE "FileVersion",      SATZIP_VER_STR
            VALUE "InternalName",     "satzip"
            VALUE "LegalCopyright",   "Samalth"
            VALUE "OriginalFilename", "satzip.exe"
            VALUE "ProductName",      "SAT-ZIP"
            VALUE "ProductVersion",   SATZIP_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x04B0
    END
END
